# Copy to .env.local (Next.js + Prisma CLI via npm run db:*)
# DATABASE_URL and AUTH_SECRET are required.

# Neon PostgreSQL — dev DB for .env.local and Vercel Preview (branch dev).
# Create a separate prod project for Vercel Production (branch main). See ENV_SETUP.md.
DATABASE_URL=

# Session signing secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# Public site URL for SEO (canonical, sitemap, Open Graph). Production: https://printshare.cz
NEXT_PUBLIC_SITE_URL=https://printshare.cz

# Vercel Blob — private storage for order STL/OBJ files (up to 50 MB).
# Client uploads (browser → Blob) REQUIRE BLOB_READ_WRITE_TOKEN.
#
# Setup:
# 1. Vercel Dashboard → Storage → Create Blob store (Private)
# 2. Connect the store to this project
# 3. Open Storage → your store → ".env.local" tab — copy BLOB_READ_WRITE_TOKEN
# 4. Project → Settings → Environment Variables — confirm BLOB_READ_WRITE_TOKEN
#    exists for Production (and Preview if you test preview URLs)
# 5. Redeploy after adding the variable
#
# Note: BLOB_STORE_ID alone is not enough for client uploads — you need the rw token.
# Without it, /api/orders/upload-mode returns mode: "server" (disk fallback, dev only).
BLOB_READ_WRITE_TOKEN=

# Google OAuth (optional) — sign in / link Google on login and profile
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Same client ID for showing the Google button in the UI (public)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# GitHub OAuth (optional) — github.com/settings/developers → New OAuth App
# Callback URL: https://<site>/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Same client ID to show the GitHub button (public)
NEXT_PUBLIC_GITHUB_CLIENT_ID=

# Sign in with Apple (optional) — needs a paid Apple Developer account
# developer.apple.com → Identifiers → Services ID (enable Sign in with Apple)
# Return URL: https://<site>/api/auth/oauth/apple/callback (localhost is not allowed)
# Keys → new key with Sign in with Apple → download the .p8 once
APPLE_CLIENT_ID=            # the Services ID, e.g. xyz.3dprintshare.web
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Full .p8 contents; newlines may be written as \n
APPLE_PRIVATE_KEY=
# Same Services ID to show the Apple button (public)
NEXT_PUBLIC_APPLE_CLIENT_ID=

# Generate with: openssl rand -base64 32
# Vercel Cron → /api/cron/purge-order-files (daily 03:00 UTC)
CRON_SECRET=

# Product mode flags (defaults — payments/moderation/fees off, donations on)
# Set to "true" on Vercel when enabling full marketplace features
# NEXT_PUBLIC_PAYMENTS_ENABLED=false
# NEXT_PUBLIC_MODERATION_ENABLED=false
# NEXT_PUBLIC_PLATFORM_FEE_ENABLED=false
# NEXT_PUBLIC_STRIPE_FEE_IN_QUOTE=false
# NEXT_PUBLIC_SUPPORT_DONATIONS_ENABLED=true
# NEXT_PUBLIC_ADS_ENABLED=false

# STRIPE_FEE_RATE=0.014
# STRIPE_FEE_FIXED_CZK=2
